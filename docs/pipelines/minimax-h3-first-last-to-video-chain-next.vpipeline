{
  "id": "minimax-h3-first-last-to-video-chain-next",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "local/MiniMax-H3-FL2VA-8bit"
      }
    },
    {
      "id": "load-image",
      "type": "load-image",
      "iports": [],
      "config": {
        "url": [
          "reference.jpg"
        ]
      }
    },
    {
      "id": "last-frame",
      "type": "image-resample",
      "iports": [
        {
          "src": "load-image",
          "oport": 0
        }
      ],
      "config": {
        "width": 960,
        "height": 544,
        "fit": "manual",
        "scale": 1.6875,
        "src_x": 455,
        "src_y": 239,
        "algorithm": "lanczos"
      }
    },
    {
      "id": "vae-encode-last",
      "type": "vae-encode",
      "iports": [
        {
          "src": "last-frame",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "always"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "The camera keeps drifting across the calm lake toward the tiered pagoda on the wooded hill, painted in thick impressionist oil strokes; a small boat glides into frame from the left, ripples catching gold light. Gentle lapping water, a soft breeze through pines, distant birdsong."
      }
    },
    {
      "id": "diffusion-conditioner",
      "type": "diffusion-conditioner",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "unload_when_idle": "always"
      }
    },
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "video_shift": 12.0,
        "audio_shift": 3.0,
        "condition_audio_timestep": 1.0,
        "audio_seconds": 0.0,
        "lora": "larryvrh/MiniMax-H3-Turbo-Lora-v4-600-ema",
        "lora_scale": 1.0
      }
    },
    {
      "id": "minimax-h3-context-import",
      "type": "minimax-h3-context-import",
      "iports": [],
      "config": {
        "input_url": "minimax-h3-fl2va-chain-01.h3ctx.safetensors",
        "context_frames": 22,
        "audio_context_frames": 0,
        "start_frame": 0,
        "duration_mode": "new_footage",
        "audio_align": "exact"
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "diffusion-conditioner",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "vae-encode-last",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-import",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-import",
          "oport": 1
        }
      ],
      "config": {
        "height": 544,
        "width": 960,
        "frames": 120,
        "fps": 24,
        "steps": 6,
        "seed": 12,
        "i8_gemm": true,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "minimax-h3-context-export",
      "type": "minimax-h3-context-export",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "generate-video",
          "oport": 1
        }
      ],
      "config": {
        "output_url": "minimax-h3-fl2va-chain-02.h3ctx.safetensors",
        "overwrite_existing": true
      }
    },
    {
      "id": "minimax-h3-context-trim",
      "type": "minimax-h3-context-trim",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        },
        {
          "src": "audio-vae-decode",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-import",
          "oport": 2
        }
      ],
      "config": {
        "trim_frames": 22,
        "conform_audio": true,
        "fps": 24,
        "luma_match": true,
        "luma_match_frames": 6,
        "declick_ms": 12
      }
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "minimax-h3-context-trim",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-trim",
          "oport": 1
        }
      ],
      "config": {
        "output_url": "minimax-h3-fl2va-chain-02.mp4",
        "enable_video": true,
        "enable_audio": true
      }
    }
  ],
  "subpipelines": []
}
