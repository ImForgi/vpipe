{
  "id": "minimax-h3-reference-to-video-chain-next",
  "stages": [
    {
      "id": "model-select",
      "type": "model-select",
      "iports": [],
      "config": {
        "hf_dir": "local/MiniMax-H3-Ref2VA-8bit"
      }
    },
    {
      "id": "text-prompt",
      "type": "text-prompt",
      "iports": [],
      "config": {
        "text": "The ginger cat from the reference picture reaches the wooden gate, stops, and pushes it open with its head, stepping through into a meadow; the camera keeps tracking beside it. Birdsong, the gate creaks, soft footsteps on grass."
      }
    },
    {
      "id": "minimax-h3-model-config",
      "type": "minimax-h3-model-config",
      "iports": [],
      "config": {
        "video_shift": 12.0,
        "audio_shift": 3.0,
        "condition_timestep": 1.0,
        "condition_audio_timestep": 1.0,
        "audio_seconds": 0.0
      }
    },
    {
      "id": "video-ref-encoder",
      "type": "video-ref-encoder",
      "iports": [
        {
          "src": "text-prompt",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {
        "references": [
          "minimax-h3-reference-subject.jpg"
        ],
        "frames": 141,
        "reference_image_short_edge": 1024,
        "unload_when_idle": "auto"
      }
    },
    {
      "id": "minimax-h3-context-import",
      "type": "minimax-h3-context-import",
      "iports": [],
      "config": {
        "input_url": "minimax-h3-chain-01.h3ctx.safetensors",
        "context_frames": 22,
        "audio_context_frames": 0,
        "start_frame": 0,
        "duration_mode": "new_footage",
        "audio_align": "exact"
      }
    },
    {
      "id": "generate-video",
      "type": "generate-video",
      "iports": [
        {
          "src": "video-ref-encoder",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "video-ref-encoder",
          "oport": 1
        },
        {
          "src": "video-ref-encoder",
          "oport": 2
        },
        {
          "src": "minimax-h3-model-config",
          "oport": 0
        },
        {
          "src": "",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-import",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-import",
          "oport": 1
        }
      ],
      "config": {
        "height": 544,
        "width": 960,
        "frames": 120,
        "fps": 24,
        "steps": 8,
        "seed": 6,
        "i8_gemm": true,
        "unload_when_idle": "always"
      }
    },
    {
      "id": "vae-decode",
      "type": "vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "audio-vae-decode",
      "type": "audio-vae-decode",
      "iports": [
        {
          "src": "generate-video",
          "oport": 1
        },
        {
          "src": "model-select",
          "oport": 0
        }
      ],
      "config": {}
    },
    {
      "id": "minimax-h3-context-export",
      "type": "minimax-h3-context-export",
      "iports": [
        {
          "src": "generate-video",
          "oport": 0
        },
        {
          "src": "generate-video",
          "oport": 1
        }
      ],
      "config": {
        "output_url": "minimax-h3-chain-02.h3ctx.safetensors",
        "overwrite_existing": true
      }
    },
    {
      "id": "minimax-h3-context-trim",
      "type": "minimax-h3-context-trim",
      "iports": [
        {
          "src": "vae-decode",
          "oport": 0
        },
        {
          "src": "audio-vae-decode",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-import",
          "oport": 2
        }
      ],
      "config": {
        "trim_frames": 22,
        "conform_audio": true,
        "fps": 24,
        "luma_match": true,
        "luma_match_frames": 6,
        "declick_ms": 12
      }
    },
    {
      "id": "rgb-to-video",
      "type": "rgb-to-video",
      "iports": [
        {
          "src": "minimax-h3-context-trim",
          "oport": 0
        }
      ],
      "config": {
        "fps": 24
      }
    },
    {
      "id": "save-video",
      "type": "save-video",
      "iports": [
        {
          "src": "rgb-to-video",
          "oport": 0
        },
        {
          "src": "minimax-h3-context-trim",
          "oport": 1
        }
      ],
      "config": {
        "output_url": "minimax-h3-chain-02.mp4",
        "enable_video": true,
        "enable_audio": true
      }
    }
  ],
  "subpipelines": []
}
